void to_json(nlohmann::json& j, const WaterRules& p) {
    j["enabled"] = p.enabled;
    j["globalLevel"] = p.globalLevel;
    j["liquidBlockName"] = p.liquidBlockName;
    j["floorBlockName"] = p.floorBlockName;
    j["regionalVariation"] = p.regionalVariation;
    j["basinStrength"] = p.basinStrength;
    j["shorelineFalloff"] = p.shorelineFalloff;
}
void from_json(const nlohmann::json& j, WaterRules& p) {
    if (j.contains("enabled")) j.at("enabled").get_to(p.enabled);
    if (j.contains("globalLevel")) j.at("globalLevel").get_to(p.globalLevel);
    if (j.contains("liquidBlockName")) j.at("liquidBlockName").get_to(p.liquidBlockName);
    if (j.contains("floorBlockName")) j.at("floorBlockName").get_to(p.floorBlockName);
    if (j.contains("regionalVariation")) j.at("regionalVariation").get_to(p.regionalVariation);
    if (j.contains("basinStrength")) j.at("basinStrength").get_to(p.basinStrength);
    if (j.contains("shorelineFalloff")) j.at("shorelineFalloff").get_to(p.shorelineFalloff);
}

void to_json(nlohmann::json& j, const BiomeEnvironment& p) {
    j["temperature"] = p.temperature;
    j["humidity"] = p.humidity;
