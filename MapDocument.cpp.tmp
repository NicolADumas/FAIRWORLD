    if (j.contains("tunnels")) j.at("tunnels").get_to(p.tunnels);
    if (j.contains("chambers")) j.at("chambers").get_to(p.chambers);
    if (j.contains("verticalBias")) j.at("verticalBias").get_to(p.verticalBias);
    if (j.contains("minDepth")) j.at("minDepth").get_to(p.minDepth);
