    j["altitude"] = p.altitude;
    j["slope"] = p.slope;
    j["latitude"] = p.latitude;
    j["waterProximity"] = p.waterProximity;
}
void from_json(const nlohmann::json& j, BiomeEnvironment& p) {
    if (j.contains("temperature")) j.at("temperature").get_to(p.temperature);
    if (j.contains("humidity")) j.at("humidity").get_to(p.humidity);
    if (j.contains("moisture")) j.at("moisture").get_to(p.moisture);
    if (j.contains("altitude")) j.at("altitude").get_to(p.altitude);
    if (j.contains("slope")) j.at("slope").get_to(p.slope);
    if (j.contains("latitude")) j.at("latitude").get_to(p.latitude);
    if (j.contains("waterProximity")) j.at("waterProximity").get_to(p.waterProximity);
}

void to_json(nlohmann::json& j, const BiomeRules& p) {
