}
void from_json(const nlohmann::json& j, BiomeRules& p) {
    if (j.contains("environment")) j.at("environment").get_to(p.environment);
}

void to_json(nlohmann::json& j, const ErosionRules& p) {
    j["enabled"] = p.enabled;
    j["hydraulicErosion"] = p.hydraulicErosion;
    j["thermalErosion"] = p.thermalErosion;
    j["sedimentation"] = p.sedimentation;
    j["weathering"] = p.weathering;
}
