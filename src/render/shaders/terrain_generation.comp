#version 450

layout(local_size_x = 17, local_size_y = 17) in;

// --- STRUTTURE DATI ---

struct ChunkData {
    vec3 center;
    float radius;
    vec4 p00;
    vec4 p10;
    vec4 p01;
    vec4 p11;
    uint chunkID;
    uint _pad0;
    uint _pad1;
    uint _pad2;
};

struct MapRegionGPU {
    vec3 centerNormal;
    float angularRadius;
    vec4 rectMinMax;     // (gridX_min, gridY_min, gridX_max, gridY_max) per isGridAligned
    uint shapeType;
    uint biomeType;
    float perlinFreq;
    float gravityMod;
    uint isGridAligned;
    uint faceIndex;      // 0-5 per le 6 facce del cubo
    uint surfaceBlock;
    uint subsurfaceBlock;
};

struct Vertex {
    vec3 position;
    vec4 color;
    vec2 roughMetal;
    uint materialID;
    vec3 normal;
    float ao;
    float light;
    float emissive;
};

// --- BUFFER ---

layout(std430, set = 0, binding = 0) readonly buffer ChunkBuffer {
    ChunkData chunks[];
};

layout(std430, set = 0, binding = 1) readonly buffer RegionBuffer {
    MapRegionGPU regions[];
};

layout(std430, set = 0, binding = 2) writeonly buffer VertexBuffer {
    Vertex vertices[];
};

// Costanti di push
layout(push_constant) uniform PushConstants {
    uint numChunks;
    uint numRegions;
    float planetRadius;
    uint baseBiomeType;
    uint baseSurfaceBlock;
    uint baseSubsurfaceBlock;
    float basePerlinFreq;
    float baseGravityMod;
} pc;

// --- SIMPLEX NOISE 3D (Ashima Arts) ---
vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v) { 
  const vec2  C = vec2(1.0/6.0, 1.0/3.0) ;
  const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);

  vec3 i  = floor(v + dot(v, C.yyy) );
  vec3 x0 = v - i + dot(i, C.xxx) ;

  vec3 g = step(x0.yzx, x0.xyz);
  vec3 l = 1.0 - g;
  vec3 i1 = min( g.xyz, l.zxy );
  vec3 i2 = max( g.xyz, l.zxy );

  vec3 x1 = x0 - i1 + C.xxx;
  vec3 x2 = x0 - i2 + C.yyy;
  vec3 x3 = x0 - D.yyy;

  i = mod289(i); 
  vec4 p = permute( permute( permute( 
             i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
           + i.y + vec4(0.0, i1.y, i2.y, 1.0 )) 
           + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));

  float n_ = 0.142857142857;
  vec3  ns = n_ * D.wyz - D.xzx;

  vec4 j = p - 49.0 * floor(p * ns.z * ns.z);

  vec4 x_ = floor(j * ns.z);
  vec4 y_ = floor(j - 7.0 * x_ );

  vec4 x = x_ *ns.x + ns.yyyy;
  vec4 y = y_ *ns.x + ns.yyyy;
  vec4 h = 1.0 - abs(x) - abs(y);

  vec4 b0 = vec4( x.xy, y.xy );
  vec4 b1 = vec4( x.zw, y.zw );

  vec4 s0 = floor(b0)*2.0 + 1.0;
  vec4 s1 = floor(b1)*2.0 + 1.0;
  vec4 sh = -step(h, vec4(0.0));

  vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
  vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;

  vec3 p0 = vec3(a0.xy,h.x);
  vec3 p1 = vec3(a0.zw,h.y);
  vec3 p2 = vec3(a1.xy,h.z);
  vec3 p3 = vec3(a1.zw,h.w);

  vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
  p0 *= norm.x;
  p1 *= norm.y;
  p2 *= norm.z;
  p3 *= norm.w;

  vec4 m = max(0.5 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
  m = m * m;
  return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1), 
                                dot(p2,x2), dot(p3,x3) ) );
}

float octaveNoise(vec3 pos, float freq, int octaves) {
    float total = 0.0;
    float maxVal = 0.0;
    float amp = 1.0;
    float f = freq;
    for(int i = 0; i < octaves; ++i) {
        total += snoise(pos * f) * amp;
        maxVal += amp;
        amp *= 0.5;
        f *= 2.0;
    }
    return total / maxVal;
}

// Converte una posizione 3D normalizzata nella faccia del cubo in (u, v) [-1, +1]
// Restituisce la faccia dominante in outFace (0-5)
vec2 normalToFaceUV(vec3 normal, out uint outFace) {
    vec3 absN = abs(normal);
    if (absN.z >= absN.x && absN.z >= absN.y) {
        outFace = (normal.z > 0.0) ? 0u : 1u;
        float s = (normal.z > 0.0) ? 1.0 : -1.0;
        return vec2(normal.x * s, normal.y) / absN.z;
    } else if (absN.x >= absN.y) {
        outFace = (normal.x > 0.0) ? 2u : 3u;
        float s = (normal.x > 0.0) ? 1.0 : -1.0;
        return vec2(-normal.z * s, normal.y) / absN.x;
    } else {
        outFace = (normal.y > 0.0) ? 4u : 5u;
        float s = (normal.y > 0.0) ? 1.0 : -1.0;
        return vec2(normal.x, -normal.z * s) / absN.y;
    }
}

// --- CALCOLO VERTICE E SDF ---

void main() {
    uint chunkIdx = gl_WorkGroupID.x;
    if (chunkIdx >= pc.numChunks) return;
    
    ChunkData chunk = chunks[chunkIdx];
    
    uint lx = gl_LocalInvocationID.x;
    uint ly = gl_LocalInvocationID.y;
    
    float u = float(lx) / 16.0;
    float v = float(ly) / 16.0;
    
    // Interpolazione bilineare dei quattro angoli del patch sulla faccia del cubo sferico
    vec3 posOnFace = mix(
        mix(chunk.p00.xyz, chunk.p10.xyz, u),
        mix(chunk.p01.xyz, chunk.p11.xyz, u),
        v
    );
    vec3 normal = normalize(posOnFace);
    
    // 1. Calcolo Base Terrain (Layer 0)
    float baseNoise = octaveNoise(normal, pc.basePerlinFreq * 100.0, 4);
    float baseHeight = pc.planetRadius + (baseNoise * pc.planetRadius * 0.05 * pc.baseGravityMod);
    uint surfaceMat = pc.baseSurfaceBlock;

    // Determina la faccia e le coordinate UV del vertice corrente
    uint vertexFace;
    vec2 vertexUV = normalToFaceUV(normal, vertexFace); // UV in [-1, +1]
    
    // 2. Valutazione Local Regions (Layer 1 - IDW)
    float chunkBlendedHeight = 0.0;
    float chunkTotalWeight = 0.0;
    float maxInfluence = -1.0;
    uint dominantMat = surfaceMat;

    for (uint i = 0; i < pc.numRegions; ++i) {
        MapRegionGPU r = regions[i];
        
        float sdf = 9999.0;
        float blendDistance = 0.08;
        
        if (r.isGridAligned == 1u) {
            if (vertexFace != r.faceIndex) {
                sdf = 9999.0; // Non appartiene a questa faccia
            } else {
                vec2 uvN = (vertexUV + 1.0) * 0.5; // [0, 1]
                uvN.y = 1.0 - uvN.y;
                
                vec2 uvMin = r.rectMinMax.xy;
                vec2 uvMax = r.rectMinMax.zw;
                
                vec2 d = max(uvMin - uvN, uvN - uvMax);
                float blendUV = 0.03; // ~3% del range UV
                sdf = max(d.x, d.y);
                blendDistance = blendUV;
            }
        } else {
            if (r.angularRadius > 0.0) {
                float dt = clamp(dot(normal, r.centerNormal), -1.0, 1.0);
                float angle = acos(dt);
                sdf = angle - r.angularRadius;
            }
        }
        
        float influence = clamp(1.0 - (sdf / blendDistance), 0.0, 1.0);
        influence = influence * influence * (3.0 - 2.0 * influence); // smoothstep
        
        if (influence > 0.0) {
            float n = octaveNoise(normal, r.perlinFreq * 100.0, 4);
            float regionHeight = pc.planetRadius + (n * pc.planetRadius * 0.05 * r.gravityMod);
            
            chunkBlendedHeight += regionHeight * influence;
            chunkTotalWeight += influence;
            
            if (influence > maxInfluence) {
                maxInfluence = influence;
                dominantMat = r.surfaceBlock;
            }
        }
    }
    
    // 3. Compositing
    float finalHeight = baseHeight;
    if (chunkTotalWeight > 0.0) {
        float avgChunkHeight = chunkBlendedHeight / chunkTotalWeight;
        float layerAlpha = clamp(chunkTotalWeight, 0.0, 1.0);
        finalHeight = mix(baseHeight, avgChunkHeight, layerAlpha);
    }
    
    // 4. Threshold Materiale
    if (maxInfluence > 0.5) {
        surfaceMat = dominantMat;
    }
    
    vec3 finalPos = normal * finalHeight;
    
    // Scrittura Output
    uint vertexIdx = chunkIdx * 289 + (ly * 17 + lx);
    vertices[vertexIdx].position = finalPos;
    vertices[vertexIdx].color = vec4(1.0);
    vertices[vertexIdx].roughMetal = vec2(0.8, 0.1);
    vertices[vertexIdx].materialID = surfaceMat;
    vertices[vertexIdx].normal = normal;
    vertices[vertexIdx].ao = 1.0;
    vertices[vertexIdx].light = 1.0;
    vertices[vertexIdx].emissive = 0.0;
}
